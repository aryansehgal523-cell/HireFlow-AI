# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireflow?schema=public"

# --- Auth (NextAuth) ---
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0) ---
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (github.com/settings/developers → OAuth Apps) ---
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # used for embeddings; optional otherwise

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=        # price_... for $20/mo
STRIPE_PRICE_EXPERT=     # price_... for $40/mo

# --- Job ingestion (official public board APIs) ---
GREENHOUSE_BOARDS=stripe,vercel,figma
LEVER_COMPANIES=
CRON_SECRET=change-me
